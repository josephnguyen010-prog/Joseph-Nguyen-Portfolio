# EmailJS credentials for the contact form.
# Copy this file to `.env.local` and fill in the three values from
# https://dashboard.emailjs.com  (Email Services / Email Templates / Account).
#
# These are inlined into the built JavaScript and are publicly visible.
# That is expected: EmailJS issues a publishable key for browser use.
# Restart `npm start` after changing them.

REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
